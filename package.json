{
  "name": "rungset",
  "version": "0.1.0-beta.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --no-warnings --experimental-strip-types scripts/navigation-test.ts && node --no-warnings --experimental-strip-types scripts/dashboard-test.ts && node --no-warnings --experimental-strip-types scripts/goals-test.ts && node --no-warnings --experimental-strip-types scripts/notes-test.ts && node --no-warnings --experimental-strip-types scripts/admin-query-test.ts && node --no-warnings --experimental-strip-types scripts/test.ts && node scripts/integration-test.mjs",
    "test:e2e": "pnpm exec playwright test",
    "test:migrations": "node scripts/migration-test.mjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply goalgenius_db --local --config wrangler.jsonc",
    "db:migrate:prod": "wrangler d1 migrations apply goalgenius_db --remote --config wrangler.jsonc",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:waf": "node scripts/configure-cloudflare-waf.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "better-auth": "^1.6.33",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^1.7.0",
    "next": "16.3.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuid": "^14.0.0",
    "validator": "^13.15.26",
    "xss": "^1.0.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@libsql/client": "^0.17.2",
    "@opennextjs/cloudflare": "^1.20.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/validator": "^13.15.10",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.145.0"
  }
}
